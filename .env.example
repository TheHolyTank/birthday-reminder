# Provided automatically by Vercel when you connect a Vercel Postgres (Neon) database
# to this project. For local dev, run `vercel env pull .env.local` after linking.
POSTGRES_URL=

# Token BotFather gives you when you create your bot (via @BotFather on Telegram).
# One shared bot serves every account — each user supplies their own chat id
# from inside the app's Telegram settings panel, not as an env var.
TELEGRAM_BOT_TOKEN=

# Required. Random secret string. Set the SAME value in Vercel's project env vars.
# Vercel automatically sends it as a Bearer token when it triggers the daily cron,
# so this route can reject any request that isn't the real cron. If unset, the
# cron endpoint now refuses ALL requests (fails closed) rather than allowing
# unauthenticated access.
CRON_SECRET=

# Required. Shared invite code needed to create an account at /signup (this app
# isn't open to the public internet — you decide who gets this code). Set the
# SAME value in Vercel's project env vars.
SITE_PASSWORD=

# Required. Random secret string (e.g. `openssl rand -base64 32`) used to sign
# session cookies. Set the SAME value in Vercel's project env vars. Rotating it
# instantly logs out every account on every device — a deliberate "log out
# everywhere" lever if you ever suspect a leak.
AUTH_SECRET=
